rules_version = '2';
// Règles de sécurité de Tables Express.
// À coller dans la console Firebase : Firestore Database > Règles > Publier.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // un profil appartient au téléphone dont l'identifiant commence son nom : <uid>_<pseudo>
    function mine(pid) { return signedIn() && pid.matches(request.auth.uid + '_[a-z0-9-]{1,24}'); }

    // Profils : pseudo et scores seulement. Lisibles un par un (si on connaît l'identifiant), jamais en liste.
    match /players/{pid} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if mine(pid)
        && request.resource.data.keys().hasOnly(['pseudo', 'code', 'weekId', 'weekPts', 'bestPct', 'games', 'updatedAt'])
        && request.resource.data.pseudo is string && request.resource.data.pseudo.size() <= 20
        && request.resource.data.code is string && request.resource.data.code.size() <= 12
        && request.resource.data.weekPts is int && request.resource.data.weekPts >= 0 && request.resource.data.weekPts <= 100000
        && request.resource.data.bestPct is int && request.resource.data.bestPct >= 0 && request.resource.data.bestPct <= 100
        && request.resource.data.games is int && request.resource.data.games >= 0;
      allow delete: if mine(pid);

      // Copains : chacun voit sa liste ; ajouter un copain l'inscrit dans les deux listes.
      match /friends/{fid} {
        allow read: if mine(pid);
        allow create: if (mine(pid) || mine(fid)) && fid != pid;
        allow delete: if mine(pid) || mine(fid);
      }
    }

    // Codes amis : on retrouve un profil seulement en tapant son code exact.
    match /codes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && mine(request.resource.data.owner)
        && code.matches('[A-Z]{1,4}-[0-9]{4}');
    }
  }
}
